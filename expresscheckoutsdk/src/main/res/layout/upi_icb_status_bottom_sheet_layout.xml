<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="20dp">

    <ImageView
        android:id="@+id/icb_status_close_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="end"
        android:background="@drawable/upi_icb_close_bg"
        android:padding="7dp"
        android:src="@drawable/ic_cancel_close"
        android:tint="@color/black_text_80" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#F5F7FA"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <FrameLayout
            android:layout_width="88dp"
            android:layout_height="56dp"
            android:background="@drawable/upi_icb_status_logo_holder_bg"
            android:padding="12dp">

            <ImageView
                android:id="@+id/icb_status_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_upi_logo" />

        </FrameLayout>

        <TextView
            android:id="@+id/icb_status_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/upi_icb_status_pending_title"
            android:textColor="@color/black_text"
            android:textFontWeight="600"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/icb_status_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:text="@string/upi_icb_status_pending_subtitle"
            android:textColor="@color/black_text_60"
            android:textSize="14sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/upi_icb_status_banner_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_saving_offer_tag" />

        <TextView
            android:id="@+id/icb_status_banner_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/upi_icb_status_success_banner"
            android:textColor="#033C2B"
            android:textFontWeight="600"
            android:textSize="14sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical"
        android:paddingHorizontal="4dp">

        <LinearLayout
            android:id="@+id/icb_status_fetching_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:gravity="center">

                <ProgressBar
                    android:id="@+id/icb_status_fetching_loader"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:indeterminateTint="#BFC9D3" />

                <ImageView
                    android:id="@+id/icb_status_fetching_done_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/tick"
                    android:visibility="gone" />

            </FrameLayout>

            <TextView
                android:id="@+id/icb_status_fetching_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:text="@string/upi_icb_status_fetching_vpa"
                android:textColor="#B31C1C1C"
                android:textSize="16sp" />

        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="14dp"
            android:layout_marginStart="11dp"
            android:background="@drawable/upi_icb_status_step_connector" />

        <LinearLayout
            android:id="@+id/icb_status_found_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/icb_status_found_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_upi_icb_step_unselected" />

            <TextView
                android:id="@+id/icb_status_found_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:text="@string/upi_icb_status_found_vpa_prefix"
                android:textColor="#B31C1C1C"
                android:textSize="16sp" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/icb_status_bhim_notice_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_info_icon"
            android:tint="@color/black_text_70" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/upi_icb_status_bhim_notice"
            android:textColor="@color/black_text_80"
            android:textSize="13sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/icb_status_continue_cta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/upi_icb_status_cta_disabled_bg"
        android:clickable="false"
        android:focusable="false"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/icb_status_continue_cta_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="2"
            android:text="@string/upi_icb_status_continue_cta"
            android:textColor="#C0C9D2"
            android:textFontWeight="600"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/icb_status_continue_cta_logo"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/upi_icb_status_cta_logo_bg"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_phone_pe"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
