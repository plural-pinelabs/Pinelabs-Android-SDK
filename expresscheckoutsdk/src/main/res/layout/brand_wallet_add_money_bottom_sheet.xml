<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottomsheet_rounded_corners"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="20dp">

    <TextView
        android:id="@+id/brand_wallet_add_money_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/brand_wallet_add_money_title"
        android:textColor="@color/black_text"
        android:textFontWeight="700"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/brand_wallet_add_money_close"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/circle_background"
        android:backgroundTint="@color/black_text_8"
        android:contentDescription="@string/close"
        android:padding="8dp"
        android:src="@drawable/ic_cancel_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/black_text_60" />

    <TextView
        android:id="@+id/brand_wallet_add_money_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="@string/brand_wallet_add_money_label"
        android:textColor="@color/black_text_80"
        android:textFontWeight="500"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/brand_wallet_add_money_title" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/brand_wallet_add_money_input"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/brand_wallet_verification_field_background"
        android:fontFamily="sans-serif-medium"
        android:digits="0123456789"
        android:imeOptions="actionDone"
        android:inputType="number"
        android:maxLines="1"
        android:paddingHorizontal="16dp"
        android:singleLine="true"
        android:textColor="@color/black_text"
        android:textFontWeight="700"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/brand_wallet_add_money_label"
        tools:text="3000" />

    <TextView
        android:id="@+id/brand_wallet_add_money_minimum"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/black_text_80"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/brand_wallet_add_money_input"
        tools:text="Minimum amount is ₹ 3,000 is required" />

    <View
        android:id="@+id/brand_wallet_add_money_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="20dp"
        android:background="@color/black_text_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/brand_wallet_add_money_minimum" />

    <TextView
        android:id="@+id/brand_wallet_add_money_quick_adds_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/brand_wallet_quick_adds"
        android:textColor="@color/black_text_80"
        android:textFontWeight="500"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/brand_wallet_add_money_divider" />

    <LinearLayout
        android:id="@+id/brand_wallet_add_money_quick_adds_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/brand_wallet_add_money_quick_adds_label">

        <TextView
            android:id="@+id/brand_wallet_quick_add_3000"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/brand_wallet_quick_add_background"
            android:gravity="center"
            android:minWidth="86dp"
            android:paddingHorizontal="12dp"
            android:text="@string/brand_wallet_quick_add_3000"
            android:textColor="@color/black_text"
            android:textFontWeight="600"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/brand_wallet_quick_add_5000"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/brand_wallet_quick_add_background"
            android:gravity="center"
            android:minWidth="86dp"
            android:paddingHorizontal="12dp"
            android:text="@string/brand_wallet_quick_add_5000"
            android:textColor="@color/black_text"
            android:textFontWeight="600"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/brand_wallet_quick_add_8000"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/brand_wallet_quick_add_background"
            android:gravity="center"
            android:minWidth="86dp"
            android:paddingHorizontal="12dp"
            android:text="@string/brand_wallet_quick_add_8000"
            android:textColor="@color/black_text"
            android:textFontWeight="600"
            android:textSize="16sp" />

    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/brand_wallet_add_money_cta"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/primary_button_disabled_bg"
        android:fontFamily="sans-serif-medium"
        android:text="@string/brand_wallet_add_money_cta"
        android:textAllCaps="false"
        android:textColor="@color/text_disabled_C0C9D2"
        android:textFontWeight="700"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/brand_wallet_add_money_quick_adds_row" />

</androidx.constraintlayout.widget.ConstraintLayout>