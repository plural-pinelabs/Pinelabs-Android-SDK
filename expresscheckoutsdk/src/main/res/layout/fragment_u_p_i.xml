<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="16dp"
    android:orientation="vertical"
    tools:context=".presentation.card.CardFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/back_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:importantForAccessibility="no"
            android:padding="8dp"
            android:src="@drawable/ic_back_arrow"
            app:tint="@color/black_text_80" />

        <ImageView
            android:id="@+id/upi_icon_fragment"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="2dp"
            android:importantForAccessibility="no"
            android:padding="4dp"
            android:src="@drawable/ic_upi_tinted" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/pay_using_upi"
            android:textColor="@color/black_text_80"
            android:textFontWeight="600"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/upi_savings_zone_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/upi_savings_zone_card_bg">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/upi_savings_zone_header"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:background="@drawable/upi_savings_zone_header_bg"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/upi_savings_zone_icon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_saving_offer_tag"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/upi_savings_zone_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/upi_savings_zone_title"
                        android:textColor="@color/savings_zone_title_teal"
                        android:textFontWeight="700"
                        android:textSize="14sp"
                        app:layout_constraintBottom_toBottomOf="@id/upi_savings_zone_icon"
                        app:layout_constraintStart_toEndOf="@id/upi_savings_zone_icon"
                        app:layout_constraintTop_toTopOf="@id/upi_savings_zone_icon" />

                    <LinearLayout
                        android:id="@+id/upi_savings_zone_cta"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="4dp"
                        android:paddingEnd="2dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <FrameLayout
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:background="@drawable/upi_savings_zone_logo_chip_bg"
                            android:elevation="2dp">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_phone_pe" />

                        </FrameLayout>

                        <TextView
                            android:id="@+id/upi_savings_zone_apps_more_count"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="-4dp"
                            android:background="@drawable/upi_savings_zone_logo_chip_bg"
                            android:elevation="2dp"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:text="@string/upi_savings_zone_apps_more_default"
                            android:textColor="@color/black_text_80"
                            android:textFontWeight="600"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/upi_savings_zone_cta_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/upi_savings_zone_cta_underlined"
                            android:textColor="@color/black_text_80"
                            android:textFontWeight="600"
                            android:textSize="12sp" />

                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/upi_savings_zone_content_row"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="12dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/upi_savings_zone_header">

                    <ImageView
                        android:id="@+id/upi_savings_zone_bank_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_upi_tinted"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/upi_savings_zone_subtitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/upi_savings_zone_subtitle"
                        android:textColor="@color/black_text_80"
                        android:textFontWeight="600"
                        android:textSize="14sp"
                        app:layout_constraintBottom_toBottomOf="@id/upi_savings_zone_bank_icon"
                        app:layout_constraintEnd_toStartOf="@id/upi_savings_zone_avail_cta"
                        app:layout_constraintStart_toEndOf="@id/upi_savings_zone_bank_icon"
                        app:layout_constraintTop_toTopOf="@id/upi_savings_zone_bank_icon" />

                    <TextView
                        android:id="@+id/upi_savings_zone_avail_cta"
                        android:layout_width="wrap_content"
                        android:layout_height="27dp"
                        android:background="@drawable/upi_savings_zone_avail_bg"
                        android:drawableEnd="@drawable/ic_chevron_white"
                        android:drawablePadding="4dp"
                        android:drawableTint="@color/black_text_80"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center_vertical"
                        android:paddingStart="10dp"
                        android:paddingEnd="8dp"
                        android:text="@string/upi_savings_zone_avail"
                        android:textColor="@color/black_text_80"
                        android:textFontWeight="600"
                        android:textSize="14sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <LinearLayout
                    android:id="@+id/upi_savings_zone_auto_applied_row"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/upi_savings_zone_auto_applied_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="4dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/upi_savings_zone_content_row">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="*"
                        android:textColor="@color/savings_zone_auto_applied_text"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/upi_savings_zone_offer_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/upi_savings_zone_auto_applied_hint"
                        android:textColor="@color/savings_zone_auto_applied_text"
                        android:textFontWeight="600"
                        android:textSize="12sp" />

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/pay_by_qr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:visibility="visible">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/bank_logo_qr_rv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/pay_by_qr_description" />

                <LinearLayout
                    android:id="@+id/pay_by_qr_btn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/primary_button_background"
                    android:clickable="true"
                    android:drawablePadding="8dp"
                    android:gravity="center"
                    android:minHeight="48dp"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_qr_white"
                        app:tint="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="sans-serif"
                        android:text="@string/generate_qr_code"
                        android:textColor="@color/white"
                        android:textFontWeight="600"
                        android:textSize="14sp" />

                </LinearLayout>


            </androidx.constraintlayout.widget.ConstraintLayout>


            <TextView
                android:id="@+id/pay_by_any_upi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/black_field_border"
                android:drawableEnd="@drawable/ic_chevron_white"
                android:drawableTint="@color/black_text"
                android:fontFamily="sans-serif"
                android:gravity="start|center_vertical"
                android:padding="16dp"
                android:text="@string/pay_by_any_upi_app"
                android:textAllCaps="false"
                android:textColor="@color/black_text"
                android:textFontWeight="600"
                android:textSize="14sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/upi_app_rv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fillViewport="true"
                tools:itemCount="5"
                tools:listitem="@layout/upi_app_item" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>