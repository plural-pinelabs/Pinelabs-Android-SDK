<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottomsheet_rounded_corners"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/brand_wallet_verification_close"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/circle_background"
        android:backgroundTint="@color/black_text_8"
        android:contentDescription="@string/close"
        android:padding="8dp"
        android:src="@drawable/ic_cancel_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/black_text_60" />

    <LinearLayout
        android:id="@+id/brand_wallet_verification_email_state"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/brand_wallet_verification_close">

        <TextView
            android:id="@+id/brand_wallet_verification_email_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/brand_wallet_verify_email_title"
            android:textColor="@color/black_text"
            android:textFontWeight="700"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/brand_wallet_verification_email_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/brand_wallet_email_label"
            android:textColor="@color/black_text_80"
            android:textFontWeight="500"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/brand_wallet_verification_email_field"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/brand_wallet_verification_field_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="14dp">

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/brand_wallet_verification_email_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="sans-serif-medium"
                android:hint="@string/brand_wallet_email_hint"
                android:importantForAutofill="yes"
                android:inputType="textEmailAddress"
                android:maxLines="1"
                android:padding="0dp"
                android:textColor="@color/black_text"
                android:textColorHint="@color/black_text_30"
                android:textSize="16sp" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/brand_wallet_verification_email_info"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_info_icon" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/brand_wallet_verification_otp_state"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/brand_wallet_verification_close">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/brand_wallet_verification_otp_illustration"
            android:layout_width="112dp"
            android:layout_height="80dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_otp_verify_screen" />

        <TextView
            android:id="@+id/brand_wallet_verification_otp_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/brand_wallet_otp_title"
            android:textColor="@color/black_text"
            android:textFontWeight="700"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/brand_wallet_verification_otp_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/brand_wallet_otp_subtitle"
            android:textColor="@color/black_text_60"
            android:textFontWeight="500"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/brand_wallet_verification_otp_field"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/brand_wallet_verification_field_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/brand_wallet_verification_otp_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="sans-serif-medium"
                android:hint="@string/brand_wallet_otp_hint"
                android:inputType="number"
                android:maxLength="6"
                android:maxLines="1"
                android:padding="0dp"
                android:textColor="@color/black_text"
                android:textColorHint="@color/black_text_30"
                android:textSize="16sp" />

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:layout_marginHorizontal="12dp"
                android:background="@color/black_text_12" />

            <TextView
                android:id="@+id/brand_wallet_verification_otp_resend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/brand_wallet_otp_resend"
                android:textColor="@color/black_text_80"
                android:textFontWeight="600"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/brand_wallet_verification_cta"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/primary_button_disabled_bg"
        android:fontFamily="sans-serif-medium"
        android:text="@string/brand_wallet_continue"
        android:textAllCaps="false"
        android:textColor="@color/text_disabled_C0C9D2"
        android:textFontWeight="700"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/brand_wallet_verification_email_state"
        tools:text="Continue" />

</androidx.constraintlayout.widget.ConstraintLayout>